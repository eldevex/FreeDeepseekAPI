{
  "manifest_version": 3,
  "name": "DeepSeek Auth Exporter",
  "version": "4.0",
  "description": "Собирает deepseek-auth.json для FreeDeepseekAPI",
  "permissions": ["cookies", "storage", "activeTab"],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "https://*.deepseek.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["injector.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "action": { "default_popup": "popup.html" }
}
