{
  "manifest_version": 3,
  "name": "DeepSeek Full Dumper",
  "version": "5.0",
  "description": "Дамп всех cookies, storage и сетевых запросов с chat.deepseek.com",
  "permissions": ["cookies", "storage", "unlimitedStorage", "activeTab"],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "https://*.deepseek.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["injector.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "action": { "default_popup": "popup.html" }
}
